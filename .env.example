# ============================================================================
# SEO / GEO / B&M Business Research Workspace — Environment Variables Template
# ============================================================================
# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — never commit real keys.
#
# These keys are also referenced in `claude_desktop_config.json.example` for
# the Claude Desktop app. Same keys, two consumers.
# ============================================================================

# Brave Search API — for the brave-search MCP server.
# Used for: SEO research, "near me" SERP samples, competitor lookups, news on
#           Google algorithm updates and platform policy changes.
# Get a key at https://api.search.brave.com/ (free tier: 2,000 queries/month).
BRAVE_API_KEY=

# Exa API — for the exa MCP server.
# Used for: higher-signal SEO + GEO/AEO best-practice content, deep research,
#           GitHub repo crawling for Phase-0 tool audits.
# Get a key at https://exa.ai/ (paid; pay-per-search).
EXA_API_KEY=

# Google APIs (optional, advanced) — for direct GBP / GSC / GA4 access.
# Most workflows here paste exported reports/screenshots into the wiki rather
# than calling APIs directly, so these are usually not needed at start.
# If you want them later: see https://console.cloud.google.com/
# GOOGLE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
