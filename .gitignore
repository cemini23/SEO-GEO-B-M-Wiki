# =============================================================================
# SEO / GEO / B&M Business Research Workspace — .gitignore
# =============================================================================
# Tracked: CLAUDE.md, LESSONS.md, ROADMAP.md, wiki/, scripts/, prompts/,
#          .gitignore, .env.example, claude_desktop_config.json.example
# Untracked: raw sources, briefs, .env, .claude/, OS cruft
# =============================================================================

# --- Raw sources (large, often copyrighted / scraped; live local only) -------
# Anchored to root so wiki-template/ placeholder dirs survive clone
/research to be indexed/
/raw-sources/

# --- Outputs staged for distribution -----------------------------------------
/briefs/

# --- Claude Code per-project state -------------------------------------------
.claude/

# --- Claude Desktop actual config (user fills in keys; example is committed) -
claude_desktop_config.json

# --- Session-state cache (changes every session; ephemeral) ------------------
hot.md

# --- Environment variables (secrets; .env.example is the committed template) -
.env

# --- macOS / editor cruft ----------------------------------------------------
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
.obsidian/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Third-party tool clones (gitignored) ------------------------------------
/tools/

# --- Local REFERENCE clones (Phase-0 audit, not runtime-wired) ----------------
/.local/

# --- Temp scratch ------------------------------------------------------------
/tmp_*.txt
/tmp_*.md
*.tmp

# --- Wrangler local cache (do not commit account/oauth cache) ----------------
**/.wrangler/

# --- Confidential MFG (Caruso) menu data -------------------------------------
# The worker imports this module at deploy time. It is never committed: the
# repository is public and the menu is unreleased. Deploy from a machine that
# holds the file; `wrangler deploy` bundles it into the Worker.
sites/outlierweekly/src/mfg-data.js
sites/outlierweekly/src/mfg-data.local.js
# Local captures of the training packet and the QR deck export
caruso-source/
# Local snapshot of the MFG training deck (menu text, never committed)
sites/outlierweekly/.mfg-deck-snapshot.txt
